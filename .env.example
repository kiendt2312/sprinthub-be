REDIS_PORT=16390
REDIS_KEY_PREFIX=sh:v1:
API_PORT=3000
API_HOST=127.0.0.1
REDIS_APP_PASSWORD=
REDIS_WORKER_PASSWORD=
REDIS_MAINT_PASSWORD=
