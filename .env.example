REDIS_WORKER_URL=
REDIS_MAINT_URL=
REDIS_TIMEOUT_MS=200
SHUTDOWN_TIMEOUT_MS=5000
UNASSIGN_BATCH_SIZE=32
AUTH_ORIGIN=http://localhost:3000
AUTH_IP_HMAC_SECRET=
AUTH_TRUSTED_PROXIES=
AUTH_SESSION_TOUCH_MS=600000
